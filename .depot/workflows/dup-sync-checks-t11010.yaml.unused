name: Duplicate synchronize check ownership repro (T-11010)

on:
  pull_request:
    types: [opened, synchronize, reopened, edited]

concurrency:
  group: dup-sync-t11010-pr-${{ github.event.pull_request.number }}
  cancel-in-progress: true

jobs:
  slow:
    runs-on: depot-ubuntu-latest
    steps:
      - name: Hold the run open long enough to be cancelled
        run: sleep 90
